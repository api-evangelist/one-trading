{
  "opencollection": "1.0.0",
  "info": {
    "name": "One Trading Fast Funding API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Funding",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Transfer Subaccount Balance",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.onetrading.com/fast/v1/subaccounts/transfers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Transfers an amount of a single currency between two accounts belonging to the authenticated account holder (main account or any subaccount). Requires SUBACCOUNT_TRANSFER scope."
        }
      ]
    }
  ],
  "bundled": true
}